FROM node:26-alpine

WORKDIR /app

# Instala o json-server globalmente
RUN npm install -g json-server

# Copia apenas o banco de dados fake
COPY db.json .

EXPOSE 3001

# Inicia o json-server escutando em todas as interfaces
CMD ["json-server", "--watch", "db.json", "--host", "0.0.0.0", "--port", "3001"]